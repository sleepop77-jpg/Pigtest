<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_coral"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_flame"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/notif_icon_flame" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="FOCUS TIMER"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="1" />

        <TextView
            android:id="@+id/widget_timer_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IDLE"
            android:textColor="#99FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="25:00"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/widget_focus_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_btn_gold"
        android:gravity="center"
        android:padding="10dp"
        android:text="START FOCUS"
        android:textColor="#FF2B0503"
        android:textStyle="bold"
        android:textSize="12sp" />
</LinearLayout>
